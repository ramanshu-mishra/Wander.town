generator client2 {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db2 {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt   DateTime
}


// user model and the space model is the most complicated one. each user has a avatar associated with each space he's enrolled in

// hence user will have an array of {spaces,avatar} which he is enrolled in and that array will be an 

// users should be allowed to login using both email and password

model User {
    id String @id @unique @default(cuid())
    username String @unique
    name String 
    password String?
    email String?
    activeSession String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())

    spaces UserSpace[]
    hostSpaces Space[] 
    cohostSpaces Space[] @relation("cohostSpaces") // it implicitly creates a join table hence on removing a space from cohostSpaces it automatically deletes the implicit row of user-space hence user gets deleted from cohosts in spaces table.
    memberSpaces Space[] @relation("memberSpaces")
    organisations Organisation[]
}

model Space {
    id String @id @unique @default(cuid())
    name String 
    hostId String 
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
    orgId String?
    organisation Organisation? @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    users UserSpace[]
    cohosts User[] @relation("cohostSpaces")
    members User[] @relation("memberSpaces")
    

    host User @relation(fields: [hostId],references: [id], onUpdate: Cascade, onDelete: Cascade)
    map Map?
    
}

model UserSpace{
    id String @id @unique @default(cuid())
    userid String 
    spaceId String 
    avatarId String @unique

    user User @relation(fields: [userid], references: [id], onDelete: Cascade, onUpdate: Cascade)
    space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    avatar Avatar?

    @@unique([userid,spaceId])
}


// hierchial organisation structure
model Organisation {
    id String @id @unique @default(cuid())
    name String 
    spaces Space[]

    parentOrgId String?
    parentOrg Organisation? @relation( "folders" ,fields: [parentOrgId], references: [id])
    childOrg Organisation[] @relation("folders")

    hostId String
    host User @relation(fields: [hostId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}


model Avatar{
  id String @id @unique @default(cuid())
  name String @default("default")
  image String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())
  userSpacesId String @unique
  userSpace UserSpace @relation(fields: [userSpacesId], references: [id])
}


model Map{
    id String @id @unique @default(cuid())
    mapId String 

    map DefaultMap @relation(fields: [mapId], references: [id], onUpdate: Cascade)
    elements MapElement[]
    spaceId String @unique
    space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model DefaultMap{
    id String @id @unique @default(cuid())
    name String 
    image String
    thumbnail String
    height Int
    width Int

    maps Map[]
}

model Element{
    id String @id @unique @default(cuid())
    type String
    variant String
    image String
    height Int
    width Int

    mapElements MapElement[]
}

model MapElement{
    id String @id @unique @default(cuid())
    x Int
    y Int
    elementId String
    mapId String 

    element Element @relation(fields: [elementId],references: [id], onDelete: Cascade, onUpdate: Cascade)
    map Map @relation(fields: [mapId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([mapId, x,y]) //so that overlaps dont occur
}









